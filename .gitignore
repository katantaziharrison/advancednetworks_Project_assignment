# Ignore everything by default
*

# Check subfolders and keep this file
!*/
!.gitignore

# LaTeX sources and PDFs
!*.tex
!*.pdf

# Bibliography files and styles
!*.bib
!*.bst
!*.bbx
!*.cbx

# Document classes, packages, and configuration
!*.cls
!*.sty
!*.clo
!*.def
!*.cfg

# Images
!*.png
!*.jpg
!*.jpeg
!*.svg
!*.eps

# Custom fonts
!*.ttf
!*.otf